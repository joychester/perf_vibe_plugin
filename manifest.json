{
  "manifest_version": 3,
  "name": "perf-vibe",
  "version": "1.0.0",
  "description": "Track and display page performance metrics with visual change tracking",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}

